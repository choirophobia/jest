{
  "name": "dummyjson-api-tests",
  "version": "1.0.0",
  "description": "End-to-end API test suite against DummyJSON using Jest and axios",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:smoke": "jest -t \"@smoke\"",
    "report:allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "report:allure:open": "allure open ./allure-report"
  },
  "devDependencies": {
    "allure-commandline": "^2.43.0",
    "allure-jest": "^3.12.1",
    "jest": "^29.7.0",
    "jest-html-reporters": "^3.1.7",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "axios": "^1.7.9"
  }
}
